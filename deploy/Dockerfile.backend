# syntax=docker/dockerfile:1
#
# Backend (NestJS): Mini App API, admin API, Telegram bot va ko'rishlar worker'i.
# Build context — apps/backend (deploy/compose.yml), keraksiz fayllar
# deploy/Dockerfile.backend.dockerignore orqali chiqarib tashlanadi.

FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build && npm prune --omit=dev

FROM node:24-alpine
ENV NODE_ENV=production \
    TZ=Asia/Tashkent
WORKDIR /app
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
USER node
CMD ["node", "dist/main.js"]
