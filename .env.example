# =============================================================================
# Reels tanlov ilovasi — muhit o'zgaruvchilari namunasi
# =============================================================================
# Bu fayl barcha o'zgaruvchilarning yagona ro'yxati (hujjat).
# HAQIQIY KALIT VA PAROLLARNI BU FAYLGA YOZMANG — u commit qilinadi.
#
# Lokal sozlash — har bir bo'limni tegishli faylga nusxalang:
#   [docker]   -> ./.env                  (docker compose o'qiydi)
#   [backend]  -> apps/backend/.env
#   [admin]    -> apps/admin/.env.local
#   [miniapp]  -> apps/miniapp/.env.local
#   [mobile]   -> apps/mobile/.env        (to'xtatilgan; flutter run --dart-define-from-file=.env)
#
# Maxfiy kalit generatsiyasi:  openssl rand -base64 32
# Yangi o'zgaruvchi qo'shsangiz — shu faylni ham yangilang (PR checklist).
# =============================================================================


# =============================================================================
# [docker] — lokal infratuzilma (docker-compose.yml)
# =============================================================================
POSTGRES_USER=reels
POSTGRES_PASSWORD=reels_local_password
POSTGRES_DB=reels_contest
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=reels
MINIO_ROOT_PASSWORD=reels_local_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001


# =============================================================================
# [backend] — apps/backend (NestJS API + worker + Telegram bot)
# =============================================================================

# --- Umumiy ---
# development | test | production
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
APP_TIMEZONE=Asia/Tashkent
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
# Backend ning tashqi manzili (OAuth callback va webhooklar uchun)
PUBLIC_API_URL=http://localhost:3000
ADMIN_PANEL_URL=http://localhost:3001
# Vergul bilan ajratilgan ro'yxat
# Admin panel (3001) va Mini App (3002)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# VAQTINCHA: admin API kaliti (Authorization: Bearer ...), admin login qurilguncha.
# Bo'sh bo'lsa — admin API (masalan, qoidalarni tahrirlash) yopiq. openssl rand -base64 32
ADMIN_API_TOKEN=

# --- Ma'lumotlar bazasi (PostgreSQL) ---
DATABASE_URL=postgresql://reels:reels_local_password@localhost:5432/reels_contest?schema=public

# --- Redis (BullMQ navbatlari, OTP limitlari, kesh) ---
REDIS_URL=redis://localhost:6379

# --- Mobil foydalanuvchi JWT ---
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=30d

# --- Admin panel sessiyasi ---
ADMIN_JWT_SECRET=
ADMIN_SESSION_TTL=8h
ADMIN_COOKIE_NAME=reels_admin_session
ADMIN_2FA_ISSUER="Reels Contest Admin"
# Faqat birinchi seed uchun. Prod da seed dan keyin o'chiring va parolni almashtiring.
SEED_ADMIN_LOGIN=
SEED_ADMIN_PASSWORD=

# --- Tasdiqlash kodi (OTP) ---
# Kod SMS bilan emas, Telegram bot orqali yetkaziladi (TELEGRAM_* ga qarang).
# mock | telegram   (mock — kodni logga yozadi, faqat development uchun)
OTP_PROVIDER=mock
OTP_LENGTH=6
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_PHONE_PER_DAY=10
OTP_MAX_SENDS_PER_IP_PER_HOUR=20

# --- Instagram (Meta) ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/v1/instagram/callback
# Faza 0 natijasiga ko'ra tanlanadi:
#   https://graph.instagram.com  — Instagram API with Instagram Login
#   https://graph.facebook.com   — Instagram API with Facebook Login
INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com
# Faza 0 da joriy barqaror versiya yoziladi (masalan: vNN.0)
INSTAGRAM_GRAPH_API_VERSION=
# Vergul bilan ajratilgan ruxsatlar ro'yxati (Faza 0 da aniqlanadi)
INSTAGRAM_SCOPES=
# OAuth tugagach mobil ilovaga qaytish (deep link)
INSTAGRAM_APP_RETURN_URL=reelscontest://instagram/callback

# --- Zavod rasmiy Instagram akkaunti (tag tekshiruvi; Faza 0 da aniqlanadi) ---
FACTORY_INSTAGRAM_USERNAME=
FACTORY_INSTAGRAM_USER_ID=
FACTORY_INSTAGRAM_ACCESS_TOKEN=

# --- Reel ko'rishlarini yig'ish (Meta API o'rniga) ---
# apify — haqiqiy ma'lumot (APIFY_API_TOKEN kerak); mock — lokal sinov uchun SOXTA ko'rishlar
STATS_PROVIDER=apify
# Apify (apify/instagram-scraper) — Console → Settings → API & Integrations. Maxfiy!
APIFY_API_TOKEN=
# Ko'rishlar soat nechada yig'iladi (Asia/Tashkent, HH:MM)
STATS_SYNC_TIME=06:00
# Tanlov boshlangan kundan (25-noyabr) boshlab necha kunda bir marta yig'iladi:
# 10 — 5-dek, 15-dek, 25-dek …; 1 — har kuni; 0 — avtomatik yig'ish o'chiq
STATS_SYNC_EVERY_DAYS=10
# Yangi yuborilgan videolar shuncha millisoniya yig'ilib, bitta so'rovda tekshiriladi
STATS_VERIFY_DELAY_MS=5000

# --- Tokenlarni shifrlash (AES-256-GCM; 32 bayt, base64) ---
TOKEN_ENCRYPTION_KEY=

# --- Kunlik jarayon (standart qiymatlar; ishchi qiymat Admin -> Sozlamalar da) ---
DAILY_SYNC_CRON="0 0 * * *"
SYNC_CONCURRENCY=5
SYNC_MAX_RETRIES=3

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
# Bot nomi (@ siz). Veb-saytdagi "Telegram orqali kirish" (Login Widget) uchun ham kerak —
# @BotFather → /setdomain da sayt domeni (masalan, konkurs.mezon.site) ko'rsatilishi shart.
TELEGRAM_BOT_USERNAME=
# polling (development) | webhook (production, hali qo'shilmagan) | off (faqat API)
TELEGRAM_MODE=polling
# Mini App manzili — faqat https (lokal sinovda tunnel orqali). Bo'sh bo'lsa, bot
# "Tanlovni ochish" tugmasini ko'rsatmaydi.
TELEGRAM_MINIAPP_URL=
# Mini App initData imzosi necha soniya amal qiladi
TELEGRAM_INITDATA_MAX_AGE=86400
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# Support operatorlari guruhining ID si (odatda -100 bilan boshlanadi)
TELEGRAM_SUPPORT_CHAT_ID=

# --- Fayl saqlash (support skrinshotlari) ---
# s3 | local
STORAGE_DRIVER=s3
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=reels-contest
S3_ACCESS_KEY=reels
S3_SECRET_KEY=reels_local_password
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_SIZE_MB=5

# --- Push bildirishnomalar (Firebase Cloud Messaging) ---
# Firebase service account JSON fayliga yo'l (fayl commit qilinmaydi).
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- AI tahlil (ixtiyoriy; provayder Faza 0/3 da tanlanadi) ---
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# --- Monitoring ---
SENTRY_DSN=


# =============================================================================
# [admin] — apps/admin (Next.js). NEXT_PUBLIC_* brauzerga ochiq bo'ladi!
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SENTRY_DSN=


# =============================================================================
# [miniapp] — apps/miniapp (Telegram Mini App, Vite). VITE_* brauzerga ochiq bo'ladi!
# =============================================================================
# Bo'sh bo'lsa — Mini App soxta (mock) ma'lumotlar bilan ishlaydi.
VITE_API_URL=


# =============================================================================
# [mobile] — apps/mobile (Flutter). --dart-define-from-file orqali o'qiladi va
# ilova ichiga joylanadi — bu yerga hech qachon maxfiy kalit yozmang!
# Kodda: const String.fromEnvironment('API_URL')
# =============================================================================
# Real qurilmada localhost ishlamaydi — kompyuteringizning lokal IP manzilini yozing.
# Android emulyator uchun: http://10.0.2.2:3000/api/v1
API_URL=http://192.168.1.10:3000/api/v1
APP_ENV=development
# uz | ru
DEFAULT_LOCALE=uz
TELEGRAM_BOT_USERNAME=
SENTRY_DSN=
