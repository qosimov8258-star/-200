# =============================================================================
# Reels tanlov ilovasi — monorepo .gitignore
# apps/backend (NestJS) · apps/admin (Next.js) · apps/mobile (Flutter)
# =============================================================================

# --- Operatsion tizim ---
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Muharrirlar / IDE ---
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~

# --- Bog'liqliklar ---
node_modules/
.pnpm-store/

# --- Maxfiy ma'lumotlar (hech qachon commit qilinmaydi) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.jks
*.keystore
*.mobileprovision
# Firebase konfiguratsiyalari — CI secret orqali beriladi
firebase-service-account*.json
google-services.json
GoogleService-Info.plist

# --- Loglar ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Build natijalari va keshlar ---
dist/
build/
out/
*.tsbuildinfo
.turbo/
.cache/

# --- Testlar va coverage ---
coverage/
.nyc_output/
test-results/
playwright-report/
junit.xml

# --- Next.js (apps/admin) ---
.next/
next-env.d.ts
.vercel/

# --- Flutter (apps/mobile) ---
# android/ va ios/ papkalari hamda pubspec.lock commit qilinadi.
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
.fvm/
apps/mobile/ios/Flutter/Generated.xcconfig
apps/mobile/ios/Flutter/flutter_export_environment.sh
apps/mobile/ios/Flutter/ephemeral/
apps/mobile/ios/.symlinks/
apps/mobile/android/key.properties

# --- Native build artefaktlari ---
.gradle/
local.properties
.cxx/
captures/
*.apk
*.aab
*.ipa
*.hprof
xcuserdata/
DerivedData/
Pods/

# --- Prisma (apps/backend) ---
# Generatsiya qilingan klient. MUHIM: prisma/migrations/ commit qilinadi!
**/generated/prisma/

# --- Lokal ma'lumotlar ---
uploads/
tmp/
.data/

# --- Claude Code shaxsiy sozlamalari ---
.claude/settings.local.json
CLAUDE.local.md
